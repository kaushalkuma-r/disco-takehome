# Copy to .env — never commit .env
OPENAI_API_KEY=sk-...
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_JWT_SECRET=...
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=            # empty = same origin (Shape A); https://<railway-app> for Shape B
# optional: Langfuse tracing (agent / tool / generation / guardrail observations per interaction)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_ENVIRONMENT=local
